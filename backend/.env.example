# ── Local development: the defaults in config.py work, so a .env is optional. ──
# ── Production: set ENV=production and fill EVERY value below with real secrets. ──
# When ENV=production the app REFUSES to start if SECRET_KEY, DATABASE_URL, or
# CORS_ORIGINS are left at their insecure defaults.

ENV=development

# Postgres connection. In production use a STRONG password (not postgres:password).
DATABASE_URL=postgresql://postgres:password@localhost:5432/rsp_db

# JWT signing key. Generate a strong one, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-0cead0c03d8ba0bc15326142050b1b43
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Allowed browser origins (comma-separated). "*" only for local dev.
# In production set to your real frontend, e.g.: https://scheduler.iitk.ac.in
CORS_ORIGINS=*

# Email (optional; the app no-ops if unset). Use your SMTP relay's details.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
