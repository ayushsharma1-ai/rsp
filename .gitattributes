# Keep line endings correct for each target OS regardless of who commits.
# Shell scripts + Linux service/config files MUST stay LF — CRLF makes Linux
# fail them ("bad interpreter: /usr/bin/env bash^M"). This guarantees the VM
# always checks them out with LF even when committed from Windows.
*.sh        text eol=lf
*.service   text eol=lf
*.conf      text eol=lf

# Windows batch files stay CRLF.
*.bat       text eol=crlf
